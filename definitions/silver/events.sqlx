config {
    type: "table",
    schema: "retailrocket_silver",
    name: "silver_events",
    description: "Silver events: deduped on (timestamp_ms, visitorid, itemid, event)",
    assertions: {
        nonNull: ["visitorid", "itemid", "timestamp_ms", "event"]
    }
}

SELECT
    timestamp,
    timestamp_ms,
    event_timestamp,
    visitorid,
    itemid,
    event,
    transactionid
FROM ${ref("bronze_events")}
WHERE timestamp_ms IS NOT NULL 
QUALIFY ROW_NUMBER() OVER (
    PARTITION BY timestamp_ms, visitorid, itemid, event
    ORDER BY transactionid DESC
) = 1
